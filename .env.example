# =============================================================================
# HƯỚNG DẪN CẤU HÌNH AI LUẬN GIẢI (TÙY CHỌN)
# Sao chép file này thành .env.local và điền API Key của nhà cung cấp bạn chọn.
# =============================================================================

# -----------------------------------------------------------------------------
# CÁCH 1: DÙNG GOOGLE GEMINI (MIỄN PHÍ 100% - KHUYÊN DÙNG SỐ 1)
# 1. Đăng ký lấy API Key miễn phí tại: https://aistudio.google.com/
# 2. Không cần nhập thẻ tín dụng, hạn mức cao (15 req/phút, 1500 req/ngày).
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash   # hoặc gemini-2.0-flash

# -----------------------------------------------------------------------------
# CÁCH 2: DÙNG GROQ CLOUD (MIỄN PHÍ 100% - TỐC ĐỘ SIÊU NHANH)
# 1. Đăng ký tại: https://console.groq.com/
# 2. Tạo API Key miễn phí không cần thẻ.
# -----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
# AI_PROVIDER=groq
# AI_MODEL=qwen/qwen3.8-27b

# -----------------------------------------------------------------------------
# CÁCH 3: DÙNG OPENROUTER (CÓ CÁC MODEL :free MIỄN PHÍ)
# 1. Đăng ký tại: https://openrouter.ai/
# 2. Lấy API Key miễn phí, dùng các model có đuôi :free
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# AI_PROVIDER=openrouter
# AI_MODEL=google/gemini-2.0-flash-exp:free

# -----------------------------------------------------------------------------
# CÁCH 4: DÙNG OLLAMA LOCAL (CHẠY OFFLINE TRÊN MÁY TÍNH - 100% FREE & RIÊNG TƯ)
# 1. Cài đặt Ollama từ https://ollama.com/
# 2. Chạy: ollama run llama3.1 hoặc ollama run qwen2.5
# -----------------------------------------------------------------------------
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# -----------------------------------------------------------------------------
# CÁCH 5: DÙNG DEEPSEEK (CHI PHÍ SIÊU RẺ, RẤT GIỎI TỬ VI ĐẨU SỐ)
# 1. Đăng ký tại: https://platform.deepseek.com/
# 2. Nạp ~1-2 USD (khoảng 25.000 - 50.000 VNĐ dùng được hàng trăm lá số)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# CÁCH 6: DÙNG OPENAI (ChatGPT)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# ─── URL Trang Web ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
